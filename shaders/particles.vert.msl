#include <metal_stdlib>
using namespace metal;

// Metal accepts one stage-in parameter. SDL describes the corner and
// per-instance values through two vertex-buffer bindings, which Metal maps
// into this single attribute structure at pipeline creation.
struct ParticleInput {
    float2 corner [[attribute(0)]];
    float2 center [[attribute(1)]];
    float2 extent [[attribute(2)]];
    float4 color [[attribute(3)]];
};

struct ParticleOutput {
    float4 position [[position]];
    float4 color [[user(locn0)]];
};

vertex ParticleOutput main0(ParticleInput input [[stage_in]]) {
    return { .position = float4(input.center + input.corner * input.extent, 0.0, 1.0), .color = input.color };
}
