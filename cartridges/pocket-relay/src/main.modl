// One-minute signal catching game
// Made by @gongahkia

state player_x: Int = 120
state signal_x: Int = 40
state signal_y: Int = 20
state score: Int = 0
state best: Int = 0
state clock: Int = 1800
state pulse: Int = 0

fn new_signal() -> Int:
  signal_x = rng_int(12, 228)
  signal_y = 16
  return signal_x

on start:
  best = save_get_int("best", 0)
  new_signal()

on update:
  if btn(pad1, left):
    player_x -= 2
  if btn(pad1, right):
    player_x += 2
  if player_x < 10:
    player_x = 10
  if player_x > 230:
    player_x = 230
  signal_y += 1
  pulse = (pulse + 1) % 24
  if signal_y >= 124:
    if signal_x >= player_x - 13 and signal_x <= player_x + 13:
      score += 1
      sfx(#catch)
    else:
      sfx(#miss)
    new_signal()
  clock -= 1
  if clock <= 0:
    if score > best:
      best = score
      save_set_int("best", best)
    score = 0
    clock = 1800

on draw:
  clear(2)
  for row in 0..9:
    line(0, row * 16 + pulse / 3, 239, row * 16 + pulse / 3, 3)
  rect_fill(player_x - 12, 128, 25, 5, 25)
  rect_fill(4, 4, score * 3, 2, 23)
  triangle(signal_x, signal_y, signal_x - 5, signal_y - 8, signal_x + 5, signal_y - 8, 19)
  print("POCKET RELAY", 80, 4, 7)
  print("CATCH", 4, 134, 15)
  print("BEST", 188, 134, 15)
  font_print(#typeface, "0123456789", 80, 134, 23)

on raster(line: Int):
  if line == 96:
    pal(3, 11)
