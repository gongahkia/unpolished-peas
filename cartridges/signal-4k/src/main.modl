// Procedural audiovisual size-code transmission
// Made by @gongahkia

state phase: Int = 0

on start:
  sfx(#ping)

on update:
  phase = (phase + 1) % 240
  mem_write(0, phase)
  if btnp(pad1, a):
    sfx(#ping)

on draw:
  clear(1)
  for band in 0..12:
    let y = 12 + band * 10
    line(0, y, 239, (y + phase + band * 7) % 144, 23)
  circle(120, 72, 18 + phase % 36, 15)
  print("SIGNAL 4K", 91, 66, 7)
  print("A RESENDS", 94, 78, 19)

on raster(line: Int):
  if line == 48:
    pal(23, 25)
    raster_scroll(phase / 8, 0)
  elif line == 96:
    pal(23, 11)
    raster_scroll(0 - phase / 8, 0)
