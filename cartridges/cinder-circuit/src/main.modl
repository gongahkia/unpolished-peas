// CINDER CIRCUIT
// Made by @gongahkia

const LEVEL_WIDTH: Int = 2048
const PLAYER_SIZE: Int = 8

enum Stage:
  Title
  Play
  Win
  Lose

state stage: Stage = Stage.Title
state player_x: Int = 16
state player_y: Int = 112
state velocity_y: Int = 0
state grounded: Bool = false
state camera_x: Int = 0
state ticks: Int = 0
state lives: Int = 3
state embers: [Int, 8] = [190, 447, 686, 933, 1188, 1457, 1756, 1949]
state flash: Color = 15
state relays: Int = 0
state relay_ready: Bool = true

fn solid_at(world_x: Int, world_y: Int) -> Bool:
  return map_flag(#world, 0, world_x / 8, world_y / 8, 0)

fn hazard_at(world_x: Int, world_y: Int) -> Bool:
  return map_flag(#world, 0, world_x / 8, world_y / 8, 2)

fn goal_at(world_x: Int, world_y: Int) -> Bool:
  return map_flag(#world, 0, world_x / 8, world_y / 8, 1)

fn reset_runner() -> Unit:
  player_x = 16
  player_y = 112
  velocity_y = 0
  grounded = false
  camera_x = 0

fn lose_life() -> Unit:
  lives -= 1
  sfx(#hurt)
  if lives <= 0:
    stage = Stage.Lose
    music_stop()
  else:
    reset_runner()

fn move_horizontal(amount: Int) -> Unit:
  var step = 1
  var count = amount
  if amount < 0:
    step = -1
    count = -amount
  for offset in 0..count:
    let next_x = player_x + step
    if not solid_at(next_x + 1, player_y + 1) and not solid_at(next_x + 6, player_y + 6):
      player_x = next_x

fn move_vertical(amount: Int) -> Unit:
  grounded = false
  var step = 1
  var count = amount
  if amount < 0:
    step = -1
    count = -amount
  for offset in 0..count:
    let next_y = player_y + step
    if step > 0 and (solid_at(player_x + 1, next_y + 7) or solid_at(player_x + 6, next_y + 7)):
      grounded = true
      velocity_y = 0
    elif step < 0 and (solid_at(player_x + 1, next_y) or solid_at(player_x + 6, next_y)):
      velocity_y = 0
    else:
      player_y = next_y

task victory_signal():
  for pulse in 0..6:
    flash = 15
    sfx(#chime)
    wait 5f
    flash = 23
    wait 5f

on start:
  reset_runner()

on update:
  ticks += 1
  if stage == Stage.Title:
    if btnp(pad1, a) or btnp(pad1, start_button):
      lives = 3
      relays = 0
      relay_ready = true
      reset_runner()
      stage = Stage.Play
      music(#theme)
  elif stage == Stage.Play:
    var horizontal = 0
    if btn(pad1, left):
      horizontal -= 1
    if btn(pad1, right):
      horizontal += 1
    move_horizontal(horizontal)
    if grounded and btnp(pad1, a):
      velocity_y = -6
      grounded = false
      sfx(#jump)
    velocity_y += 1
    if velocity_y > 4:
      velocity_y = 4
    move_vertical(velocity_y)
    if player_x - camera_x > 156:
      camera_x = player_x - 156
    elif player_x - camera_x < 72:
      camera_x = player_x - 72
    if camera_x < 0:
      camera_x = 0
    if camera_x > LEVEL_WIDTH - 240:
      camera_x = LEVEL_WIDTH - 240
    if player_y > 136 or hazard_at(player_x + 4, player_y + 7):
      lose_life()
    elif goal_at(player_x + 4, player_y + 4):
      if relay_ready:
        relays += 1
        relay_ready = false
        sfx(#chime)
        if relays >= 4:
          stage = Stage.Win
          music_stop()
          start victory_signal()
        else:
          reset_runner()
          relay_ready = true
    else:
      relay_ready = true
  elif btnp(pad1, a) or btnp(pad1, start_button):
    stage = Stage.Title

on draw:
  if stage == Stage.Title:
    clear(1)
    for stripe in 0..18:
      line(0, stripe * 8, 239, stripe * 8, dither(stripe, ticks / 8, 8, 12, 7))
    animation(#runner, (ticks / 12) % 2, 116, 46)
    rect_fill(26, 66, 188, 55, 1)
    rect(26, 66, 188, 55, 15)
    print("CINDER CIRCUIT", 76, 75, 15)
    print("ARROWS MOVE  Z JUMPS", 55, 91, 7)
    print("RESTORE FOUR RELAYS", 64, 101, 23)
    print("Z OR ENTER TO START", 61, 111, 11)
  elif stage == Stage.Play:
    clear(25)
    camera(camera_x, 0)
    map(#world, 0, 0)
    for index in 0..8:
      let ember_x = embers[index]
      let ember_y = 32 + ((index * 17 + ticks / 3) % 58)
      pixel(ember_x, ember_y, dither(ember_x, ember_y, 14, 11, 8))
    animation(#runner, (ticks / 7) % 2, player_x, player_y)
    camera(0, 0)
    rect_fill(0, 0, 240, 10, 1)
    print("CINDER CIRCUIT", 4, 2, 15)
    if relays == 0:
      print("R OOOO", 132, 2, 15)
    elif relays == 1:
      print("R #OOO", 132, 2, 15)
    elif relays == 2:
      print("R ##OO", 132, 2, 15)
    else:
      print("R ###O", 132, 2, 15)
    if lives == 3:
      print("LIVES OOO", 176, 2, 23)
    elif lives == 2:
      print("LIVES OO", 182, 2, 23)
    else:
      print("LIVES O", 188, 2, 11)
  elif stage == Stage.Win:
    clear(1)
    rect_fill(18, 18, 204, 108, flash)
    rect_fill(22, 22, 196, 100, 1)
    animation(#runner, (ticks / 7) % 2, 116, 50)
    print("FOUR RELAYS LIVE", 70, 78, 23)
    print("THE CIRCUIT GLOWS", 67, 91, 15)
    print("Z TO RETURN", 88, 108, 7)
  else:
    clear(8)
    rect_fill(34, 30, 172, 82, 1)
    rect(34, 30, 172, 82, 11)
    print("SIGNAL LOST", 87, 48, 11)
    print("MIND THE EMBER PITS", 58, 68, 15)
    print("Z TO RETRY", 91, 91, 7)

on raster(line: Int):
  if stage == Stage.Title and line < 64:
    raster_scroll((line + ticks / 2) % 4, 0)
