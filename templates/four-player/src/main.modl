state p1: Int = 20
state p2: Int = 75
state p3: Int = 130
state p4: Int = 185
on update:
  if btn(pad1, right):
    p1 += 1
  if btn(pad2, right):
    p2 += 1
  if btn(pad3, right):
    p3 += 1
  if btn(pad4, right):
    p4 += 1
on draw:
  clear(1)
  circle_fill(p1, 72, 6, 7)
  circle_fill(p2, 72, 6, 11)
  circle_fill(p3, 72, 6, 19)
  circle_fill(p4, 72, 6, 23)
