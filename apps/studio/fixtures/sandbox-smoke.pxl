state frames: Int = 0

on start:
  save_set_int("boots", save_get_int("boots", 0) + 1)

on update:
  frames += 1

on draw:
  clear(1)
  rect_fill(6, 6, 228, 132, 2)
  rect(8, 8, 224, 128, 23)
  line(12, 112, 228, 32, 26)
  circle_fill(54, 75, 26, 10)
  circle(54, 75, 20, 16)
  triangle(102, 104, 152, 28, 202, 104, 15)
  print("PX-240C INDEXED COLOR", 14, 14, 7)

on raster(line: Int):
  if line >= 96:
    pal(15, 11)
    raster_scroll(1, 0)
